# ============================================================
# Cloudflare Deployment
# ============================================================

# Cloudflare API token used only by the local/CI deployment CLI.
# Never expose this variable to browser code.
# Never prefix this variable with NEXT_PUBLIC_.
CLOUDFLARE_API_TOKEN=

# Optional Cloudflare Account ID.
# Only required when the API token can access multiple accounts
# or when the deployment account needs to be explicitly selected.
CLOUDFLARE_ACCOUNT_ID=


# ============================================================
# Application
# ============================================================

# Variables prefixed with NEXT_PUBLIC_ are included in the browser bundle.
# Store only information that is safe to disclose publicly.
# Never place tokens, secrets, private keys, or private RPC credentials in them.

# Application runtime environment.
# Suggested values: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Backend API base URL used by the frontend.
# Example:
# https://api.example.com
NEXT_PUBLIC_API_BASE_URL=


# ============================================================
# Privy
# ============================================================

# Public Privy App ID for the current environment.
# This value is used in browser code and may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_PRIVY_APP_ID=


# ============================================================
# EVM
# ============================================================

# Default EVM chain ID used by the application.
#
# Common examples:
# Ethereum Mainnet: 1
# BNB Smart Chain: 56
# Base: 8453
# Arbitrum One: 42161
#
# Chain definitions themselves should normally live in source code
# such as src/config/chains.ts. This environment variable is only
# for selecting the default chain per environment when necessary.
# Keep stable chain names, explorers, native currencies, and supported
# chain lists in src/config/chains.ts instead of duplicating them here.
NEXT_PUBLIC_DEFAULT_EVM_CHAIN_ID=

# Public EVM RPC endpoint.
#
# Used for public blockchain reads.
# Do not put private credentials in a NEXT_PUBLIC_ variable.
# If the RPC URL contains a secret API key, create a server-only
# variable instead of exposing it to the browser.
NEXT_PUBLIC_EVM_RPC_URL=

# Example application contract address.
#
# Must be a valid 0x-prefixed EVM address.
# Only use environment variables for contract addresses when the
# address differs between development/staging/production.
# Fixed chain-level addresses should live in src/config/contracts.ts.
NEXT_PUBLIC_EVM_CONTRACT_ADDRESS=


# ============================================================
# Solana
# ============================================================

# Public Solana RPC endpoint when the current environment requires
# a configurable RPC provider.
#
# If the URL contains a private API key, do not expose it through
# NEXT_PUBLIC_ and handle it server-side instead.
NEXT_PUBLIC_SOLANA_RPC_URL=


# ============================================================
# Development / Debugging
# ============================================================

# Enable vConsole for H5/mobile debugging.
# Recommended:
# development/staging: true when needed
# production: false
NEXT_PUBLIC_ENABLE_VCONSOLE=false
