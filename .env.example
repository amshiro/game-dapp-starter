# ORI Environment Contract V1
#
# 本文件是环境变量契约：列出项目需要的全部变量名，不包含任何真实值。
#
# 文件职责（除本文件外全部被 Git 忽略）：
#   .env.example           契约（tracked）
#   .env.development.local 本机 Development 运行配置（vite dev 读取）
#   .env.production.local  本机 Production 构建配置（vite build 读取）
#   .env                   本地工具与 Cloudflare 部署凭据
# 读取优先级：process.env > .env.<mode>.local > .env.local > .env.<mode> > .env
#
# 分类：
#   Public   以 NEXT_PUBLIC_ 开头，会被打包进浏览器，只能放可公开的值。
#   Server   仅 Server / Worker 可读，不得添加 NEXT_PUBLIC_ 前缀。
#   Secret   Server 中的机密值；生产环境通过 Cloudflare Secret 提供，不写入任何被跟踪的文件。
#   Deploy   仅本地 / CI 部署工具使用，不进入应用运行时。
#
# 环境必须整体一致：Development 全部使用开发配置（BSC Testnet 97、Privy Dev App、开发后端），
# Production 全部使用生产配置（BSC Mainnet 56、Privy Production App、生产后端），禁止混用。
# 合约地址不放在环境变量中，由按 chainId 组织的部署注册表提供。


# ============================================================
# Application
# ============================================================

# 应用环境：development | production。
# Public。与 NODE_ENV 无关；Dev / Prod 不同。
NEXT_PUBLIC_APP_ENV=


# ============================================================
# Site / Backend
# ============================================================

# 当前站点完整 origin，用于重定向、回调、绝对链接与分享链接，例如 https://example.com（不带结尾 /）。
# Public；Dev / Prod 不同。
NEXT_PUBLIC_SITE_URL=

# ORI 后端 API Base URL（浏览器直接访问）。
# Public；Dev / Prod 不同。不得包含凭据。
NEXT_PUBLIC_API_BASE_URL=

# ORI 后端要求的公开应用标识（不是 Privy App ID，不具备 Secret 权限）。
# Public；Dev / Prod 可能不同。
NEXT_PUBLIC_BACKEND_APP_ID=


# ============================================================
# Privy
# ============================================================

# Privy App ID（公开客户端配置，不是 App Secret）。
# Public；Dev / Prod 使用不同的 Privy App。Privy App Secret 不属于前端，不得创建对应变量。
NEXT_PUBLIC_PRIVY_APP_ID=


# ============================================================
# Realtime
# ============================================================

# ORI 实时 / WebSocket 客户端 endpoint。
# Public；Dev / Prod 不同。只能填写浏览器可安全使用的地址，不得包含 Server Secret 或特权凭据。
NEXT_PUBLIC_WS_URL=


# ============================================================
# Referral
# ============================================================

# ORI 邀请 / 长链接使用的公开标识。
# Public；若日后发现其具有认证权限，必须重新分类为 Secret。
NEXT_PUBLIC_REFERRAL_CODE=


# ============================================================
# IPFS
# ============================================================

# 公开 IPFS Gateway Base URL（图片、metadata 等公开资源）。
# Public；Dev / Prod 可以不同。
NEXT_PUBLIC_IPFS_GATEWAY_URL=


# ============================================================
# Access Policy
# ============================================================

# 受限地区，逗号分隔的 ISO 3166-1 alpha-2 国家代码，例如 CN 或 CN,US。
# Server / Policy；由 Cloudflare / Worker 依据可信 geo 信息执行，不依赖客户端 JS。
RESTRICTED_COUNTRIES=


# ============================================================
# EVM / BNB Smart Chain
# ============================================================

# 默认 EVM chainId，十进制正整数：Development 为 97（BSC Testnet），Production 为 56（BSC Mainnet）。
# Public；Dev / Prod 不同。
NEXT_PUBLIC_DEFAULT_EVM_CHAIN_ID=

# EVM RPC endpoint，必须与上面的 chainId 属于同一网络。
# Public：只允许浏览器可安全使用的 endpoint。
# 带私密 API key 的 RPC 不得写在这里，应改用域名限制的公开 endpoint 或 Worker / Server RPC 代理。
NEXT_PUBLIC_EVM_RPC_URL=


# ============================================================
# Development Debugging
# ============================================================

# 是否启用 vConsole：只接受 true / false，空值视为 false。Production 默认 false。
# Public。
NEXT_PUBLIC_ENABLE_VCONSOLE=


# ============================================================
# Server Secrets
# ============================================================

# ORI 后端接口签名 / 鉴权 Secret。
# Secret：不得添加 NEXT_PUBLIC_ 前缀，不得暴露给浏览器或 Client Component；
# 浏览器需要依赖它的后端能力时必须经过 Server / Worker。生产环境使用 Cloudflare Secret。
BACKEND_APP_SECRET=

# IPFS 服务授权 JWT。
# Secret：只能由 Server / Worker 使用，不得进入客户端 bundle。生产环境使用 Cloudflare Secret。
IPFS_JWT=


# ============================================================
# Cloudflare Deployment
# ============================================================

# Cloudflare Account ID，仅在 token 可访问多个账户时需要。
# Deploy；不进入应用运行时。
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token，仅供本地 / CI 部署工具使用。
# Deploy Secret：不得添加 NEXT_PUBLIC_ 前缀，不得进入 Worker 运行时或浏览器。真实值只放在 .env。
CLOUDFLARE_API_TOKEN=
